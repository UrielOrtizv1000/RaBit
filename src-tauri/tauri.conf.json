{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RaBit",
  "version": "0.2.0",
  "identifier": "app.rabit.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RaBit",
        "width": 1600,
        "height": 980,
        "minWidth": 1280,
        "minHeight": 800,
        "decorations": false,
        "resizable": true,
        "center": true,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app", "appimage", "deb", "rpm"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true,
    "publisher": "Uriel Ortiz",
    "copyright": "Copyright © 2026 Uriel Ortiz",
    "category": "Productivity",
    "shortDescription": "Local-first desktop organizer",
    "longDescription": "RaBit is a free, local-first desktop organizer for tasks, events, notes and routine. No account, no cloud, no ads.",
    "license": "../LICENSE",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "section": "utils",
        "recommends": ["libnotify-bin"]
      },
      "rpm": {
        "recommends": ["libnotify"]
      }
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installMode": "currentUser",
        "languages": ["English", "Spanish"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/UrielOrtizv1000/RaBit/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2NzIxMkJBNDk3MjY3ODgKUldTSVozSkp1aEp5NW54cTVmQVBTaldJUGRiZVRMV2JxcWswNTNHWVNHV3lWR2czU05iaXhneEgK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
