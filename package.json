{
  "name": "rabit",
  "private": true,
  "version": "0.2.0",
  "description": "Local-first desktop organizer for tasks, events, notes and routine",
  "author": "Uriel Ortiz",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UrielOrtizv1000/RaBit.git"
  },
  "homepage": "https://github.com/UrielOrtizv1000/RaBit#readme",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "demo": "node scripts/demo.mjs",
    "screenshots": "playwright test -c scripts/screenshots/playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src tests",
    "lint:fix": "oxlint --fix src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:check": "node scripts/release-check.mjs",
    "release:set-pubkey": "node scripts/set-pubkey.mjs",
    "qa:permissions": "node scripts/qa/permissions-check.mjs",
    "package": "node scripts/package.mjs",
    "update-sim": "node scripts/update-sim.mjs",
    "update-sim:web": "node scripts/update-sim.mjs --web",
    "clean": "node scripts/clean.mjs"
  },
  "dependencies": {
    "@fontsource/doto": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-notification": "^2.5.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-sql": "^2.5.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "framer-motion": "^14.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  }
}
