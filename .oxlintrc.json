{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2022": true
  },
  "ignorePatterns": ["dist", "node_modules", "src-tauri/target", "src-tauri/gen", "installers", "design", "test-results", "scripts", "tools"],
  "rules": {
    "typescript/no-explicit-any": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "no-empty": "error",
    "no-console": [
      "warn",
      {
        "allow": ["warn", "error"]
      }
    ],
    "react/exhaustive-deps": "warn",
    "react/rules-of-hooks": "error",
    "react/purity": "warn",
    "react/refs": "warn",
    "react/set-state-in-effect": "warn"
  }
}
